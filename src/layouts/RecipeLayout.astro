---
export interface Props {
  title: string;
  description?: string;
  servings?: number;
  prepTime?: number;
  cookTime?: number;
  categories?: string[];
  difficulty?: string;
  cuisine?: string;
}

const { title, description, servings, prepTime, cookTime, categories, difficulty, cuisine } = Astro.props;
const totalTime = prepTime && cookTime ? prepTime + cookTime : undefined;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - My Recipe Box</title>
    <meta name="description" content={description || title} />
  </head>
  <body>
    <nav>
      <a href="/">← Back to Recipe Box</a>
    </nav>
    <main>
      <article class="recipe">
        <header>
          <h1>{title}</h1>
          {description && <p class="description">{description}</p>}
          
          <div class="recipe-meta">
            {servings && <span>Servings: {servings}</span>}
            {prepTime && <span>Prep: {prepTime} min</span>}
            {cookTime && <span>Cook: {cookTime} min</span>}
            {totalTime && <span>Total: {totalTime} min</span>}
            {difficulty && <span>Difficulty: {difficulty}</span>}
            {cuisine && <span>Cuisine: {cuisine}</span>}
          </div>
          
          {categories && categories.length > 0 && (
            <div class="categories">
              {categories.map(category => (
                <span class="category">{category}</span>
              ))}
            </div>
          )}
        </header>
        
        <div class="content">
          <slot />
        </div>
      </article>
    </main>
    
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 800px;
        margin: 0 auto;
        padding: 1rem;
      }
      
      nav {
        margin-bottom: 1rem;
      }
      
      nav a {
        color: #2c3e50;
        text-decoration: none;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
      }
      
      nav a:hover {
        text-decoration: underline;
      }
      
      .recipe {
        background: white;
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      }
      
      h1 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
        font-size: 1.75rem;
      }
      
      h2 {
        color: #2c3e50;
        margin-top: 1.5rem;
        margin-bottom: 0.75rem;
        font-size: 1.25rem;
      }
      
      .description {
        color: #666;
        font-style: italic;
        margin-bottom: 1rem;
      }
      
      .recipe-meta {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
        font-size: 0.9rem;
        color: #666;
      }
      
      .categories {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
      }
      
      .category {
        background: #e0e0e0;
        padding: 0.25rem 0.75rem;
        border-radius: 16px;
        font-size: 0.85rem;
      }
      
      .content ul, .content ol {
        padding-left: 1.5rem;
      }
      
      .content li {
        margin-bottom: 0.5rem;
      }
      
      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 1rem 0;
      }
      
      @media (max-width: 768px) {
        body {
          padding: 0.75rem;
        }
        
        .recipe {
          padding: 1rem;
          border-radius: 6px;
        }
        
        h1 {
          font-size: 1.5rem;
        }
        
        h2 {
          font-size: 1.15rem;
          margin-top: 1.25rem;
        }
        
        .description {
          font-size: 0.95rem;
        }
        
        .recipe-meta {
          font-size: 0.85rem;
          gap: 0.75rem;
        }
        
        .categories {
          gap: 0.4rem;
        }
        
        .category {
          font-size: 0.8rem;
          padding: 0.2rem 0.6rem;
        }
        
        .content {
          font-size: 0.95rem;
        }
        
        .content ul, .content ol {
          padding-left: 1.25rem;
        }
      }
    </style>
  </body>
</html>