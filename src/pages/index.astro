---
import { getCollection } from 'astro:content';

const recipes = await getCollection('recipes');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>My Recipe Box</title>
    <meta name="description" content="My personal recipe box - a collection of family recipes and favorites" />
  </head>
  <body>
    <main>
      <h1>My Recipe Box</h1>
      <p>A collection of family recipes and personal favorites</p>
      
      <div class="recipe-grid">
        {recipes.map((recipe) => (
          <a href={`/recipes/${recipe.slug}`} class="recipe-card">
            <h2>{recipe.data.title}</h2>
            {recipe.data.description && (
              <p>{recipe.data.description}</p>
            )}
            <div class="recipe-meta">
              {recipe.data.servings && <span>Servings: {recipe.data.servings}</span>}
              {recipe.data.cookTime && <span>Cook time: {recipe.data.cookTime} min</span>}
            </div>
          </a>
        ))}
      </div>
    </main>
    
    <style>
      body {
        font-family: system-ui, -apple-system, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem;
      }
      
      h1 {
        color: #2c3e50;
        text-align: center;
        margin-bottom: 0.5rem;
        font-size: 2rem;
      }
      
      p {
        text-align: center;
        color: #666;
        margin-bottom: 2rem;
      }
      
      .recipe-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
      }
      
      .recipe-card {
        background: white;
        padding: 1.25rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        text-decoration: none;
        color: inherit;
        transition: transform 0.2s, box-shadow 0.2s;
      }
      
      .recipe-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0,0,0,0.15);
      }
      
      .recipe-card h2 {
        color: #2c3e50;
        margin-bottom: 0.5rem;
        font-size: 1.25rem;
      }
      
      .recipe-card p {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        text-align: left;
      }
      
      .recipe-meta {
        display: flex;
        gap: 1rem;
        font-size: 0.85rem;
        color: #999;
        flex-wrap: wrap;
      }
      
      @media (max-width: 768px) {
        body {
          padding: 0.75rem;
        }
        
        h1 {
          font-size: 1.75rem;
          margin-bottom: 0.25rem;
        }
        
        p {
          font-size: 0.95rem;
          margin-bottom: 1.5rem;
        }
        
        .recipe-grid {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
        
        .recipe-card {
          padding: 1rem;
        }
        
        .recipe-card h2 {
          font-size: 1.15rem;
        }
        
        .recipe-card p {
          font-size: 0.85rem;
        }
        
        .recipe-meta {
          font-size: 0.8rem;
          gap: 0.75rem;
        }
      }
    </style>
  </body>
</html>