---
import { getCollection } from 'astro:content';
import Search from '../components/Search.astro';
import "../styles/global.css";

const recipes = await getCollection('recipes');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>My Recipe Box</title>
    <meta name="description" content="My personal recipe box - a collection of family recipes and favorites" />
  </head>
  <body style="min-height: 100vh; background-color: #f9fafb;">
    <main style="max-width: 80rem; margin: 0 auto; padding: 2rem 1rem;">
      <header style="text-align: center; margin-bottom: 2rem;">
        <h1 style="font-size: 2.25rem; font-weight: bold; color: #111827; margin-bottom: 0.5rem;">My Recipe Box</h1>
        <p style="color: #6b7280; font-size: 1.125rem;">A collection of family recipes and personal favorites</p>
      </header>
      
      <Search />
      
      <div class="recipe-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
        {recipes.map((recipe) => (
          <a 
            href={`/recipes/${recipe.slug}`} 
            class="recipe-card"
            style="background: white; border-radius: 0.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); padding: 1.5rem; text-decoration: none; color: inherit; transition: all 0.2s; display: block;"
          >
            <h2 style="font-size: 1.25rem; font-weight: bold; color: #111827; margin-bottom: 0.5rem;">{recipe.data.title}</h2>
            {recipe.data.description && (
              <p style="color: #6b7280; margin-bottom: 1rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">{recipe.data.description}</p>
            )}
            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.875rem; color: #9ca3af;">
              {recipe.data.servings && (
                <span style="display: flex; align-items: center; gap: 0.25rem;">
                  <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                  </svg>
                  {recipe.data.servings} servings
                </span>
              )}
              {recipe.data.cookTime && (
                <span style="display: flex; align-items: center; gap: 0.25rem;">
                  <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  {recipe.data.cookTime} min
                </span>
              )}
              {recipe.data.difficulty && (
                <span style={`display: inline-flex; align-items: center; padding: 0.125rem 0.5rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; ${
                  recipe.data.difficulty === 'easy' ? 'background-color: #d1fae5; color: #065f46;' :
                  recipe.data.difficulty === 'medium' ? 'background-color: #fef3c7; color: #92400e;' :
                  'background-color: #fee2e2; color: #991b1b;'
                }`}>
                  {recipe.data.difficulty}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </main>
    
    <style>
      .recipe-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      }
      
      @media (max-width: 768px) {
        body {
          padding: 0;
        }
        
        main {
          padding: 1.5rem 0.75rem;
        }
        
        h1 {
          font-size: 1.875rem;
        }
        
        .recipe-grid {
          grid-template-columns: 1fr !important;
          gap: 1rem !important;
        }
      }
    </style>
  </body>
</html>